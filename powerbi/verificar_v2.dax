// Ejecutar en Vista de consultas DAX DESPUÉS de agregar medidas_v2.dax al modelo.
// Referencias calculadas desde los CSV el 6-nov-2026; no prueban por sí solas la interfaz.
// Tolerancia absoluta: 0.001. Un blanco esperado NO equivale a cero.
EVALUATE
VAR casos = UNION (
    ROW ( "Caso", "I1 aéreas 2025", "Resultado",
        CALCULATE ( [Llegadas], REMOVEFILTERS (), dim_fecha[Año] = 2025, dim_frontera[Vía] = "Aérea" ),
        "Esperado", 1188971.0 ),
    ROW ( "Caso", "I2 MAE Total ARIMA", "Resultado",
        CALCULATE ( [MAE], REMOVEFILTERS (), dim_serie[Serie] = "Total", dim_modelo[ModeloId] = 1 ),
        "Esperado", 154494.16500384128 ),
    ROW ( "Caso", "Tabla MAE no cambia con 2025", "Resultado",
        CALCULATE ( [MAE], REMOVEFILTERS (), dim_serie[Serie] = "Total", dim_modelo[ModeloId] = 1, dim_fecha[Año] = 2025 ),
        "Esperado", 154494.16500384128 ),
    ROW ( "Caso", "MAE visible sí cambia con 2025", "Resultado",
        CALCULATE ( [MAE período visible], REMOVEFILTERS (), dim_serie[Serie] = "Total", dim_modelo[ModeloId] = 1, dim_fecha[Año] = 2025 ),
        "Esperado", 189226.76705441668 ),
    ROW ( "Caso", "V9 Aérea HW julio", "Resultado",
        CALCULATE ( [MAE período visible], REMOVEFILTERS (), dim_serie[Serie] = "Aérea", dim_modelo[ModeloId] = 2, dim_fecha[Mes] = 7 ),
        "Esperado", 60048.1682822 ),
    ROW ( "Caso", "Observado no se triplica por modelos", "Resultado",
        CALCULATE ( [Observado una serie], REMOVEFILTERS (), dim_serie[Serie] = "Total", dim_fecha[FechaId] = 202606 ),
        "Esperado", 245687.580977 ),
    ROW ( "Caso", "Varias series no se suman", "Resultado",
        CALCULATE ( [Observado una serie], REMOVEFILTERS () ), "Esperado", BLANK () ),
    ROW ( "Caso", "ARIMA oculto al elegir solo HW", "Resultado",
        CALCULATE ( [Predicción ARIMA], REMOVEFILTERS (), dim_serie[Serie] = "Total", dim_modelo[ModeloId] = 2 ),
        "Esperado", BLANK () ),
    ROW ( "Caso", "El Salvador sobre TODOS los extranjeros, no solo Centroamérica", "Resultado",
        CALCULATE ( [Peso país sobre extranjeros], REMOVEFILTERS (), dim_fecha[Año] = 2025,
            dim_pais[Región] = "América Del Centro", dim_pais[País] = "El Salvador" ),
        "Esperado", 0.47216835496252463 ),
    ROW ( "Caso", "Índice diciembre 2025 aire+tierra", "Resultado",
        CALCULATE ( [Índice estacional], REMOVEFILTERS (), dim_fecha[Año] = 2025, dim_fecha[Mes] = 12,
            dim_frontera[Vía] IN { "Aérea", "Terrestre" } ), "Esperado", 130.8621276352948 ),
    ROW ( "Caso", "Año incompleto 2026 sin índice", "Resultado",
        CALCULATE ( [Índice estacional], REMOVEFILTERS (), dim_fecha[Año] = 2026, dim_fecha[Mes] = 1,
            dim_frontera[Vía] IN { "Aérea", "Terrestre" } ), "Esperado", BLANK () ),
    ROW ( "Caso", "Marítima 2025 sin registros", "Resultado",
        CALCULATE ( [Índice estacional], REMOVEFILTERS (), dim_fecha[Año] = 2025, dim_fecha[Mes] = 12,
            dim_frontera[Vía] = "Marítima" ), "Esperado", BLANK () ),
    ROW ( "Caso", "Perfil mediana no se reduce al año en foco", "Resultado",
        CALCULATE ( [Perfil mediana], REMOVEFILTERS (), dim_fecha[Año] = 2025, dim_fecha[Mes] = 12,
            dim_frontera[Vía] IN { "Aérea", "Terrestre" } ), "Esperado", 134.5237949958254 ),
    ROW ( "Caso", "Perfil mediana igual al cambiar foco a 2019", "Resultado",
        CALCULATE ( [Perfil mediana], REMOVEFILTERS (), dim_fecha[Año] = 2019, dim_fecha[Mes] = 12,
            dim_frontera[Vía] IN { "Aérea", "Terrestre" } ), "Esperado", 134.5237949958254 ),
    ROW ( "Caso", "Perfil mínimo diciembre", "Resultado",
        CALCULATE ( [Perfil mínimo], REMOVEFILTERS (), dim_fecha[Mes] = 12,
            dim_frontera[Vía] IN { "Aérea", "Terrestre" } ), "Esperado", 124.54010870811362 ),
    ROW ( "Caso", "Perfil máximo diciembre", "Resultado",
        CALCULATE ( [Perfil máximo], REMOVEFILTERS (), dim_fecha[Mes] = 12,
            dim_frontera[Vía] IN { "Aérea", "Terrestre" } ), "Esperado", 148.7365516163329 )
)
RETURN ADDCOLUMNS ( casos, "Correcto",
    IF ( ISBLANK ( [Esperado] ), ISBLANK ( [Resultado] ),
        NOT ISBLANK ( [Resultado] ) && ABS ( [Resultado] - [Esperado] ) <= 0.001 ) )
ORDER BY [Caso]
